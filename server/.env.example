# CampusRoots - Alumni Meetup Platform Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
DB_URL=mongodb://localhost:27017/campusroots

# JWT Secret
JWT_SECRET=your-secret-key-here

# Frontend URL
CLIENT_URL=http://localhost:5173

# Twilio SMS Configuration (for OTP verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Configuration (for Email OTP - Gmail SMTP)
# Note: Use an App Password for Gmail, not your regular password
# Go to Google Account > Security > 2-Step Verification > App passwords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
